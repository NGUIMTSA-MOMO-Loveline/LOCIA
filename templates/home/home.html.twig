<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Instagram Clone</title>
  <style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background-color: rgb(0, 0, 0);
        color: #fff;
    }

    .page-layout {
        display: flex;
        min-height: 100vh;
    }

    /* Sidebar gauche */
    .sidebar {
        width: 220px;
        background-color: rgb(0, 0, 0);
        border-right: 1px solid #444;
        padding: 2rem 1rem;
        position: sticky;
        top: 0;
        height: 100vh;
    }

    .sidebar h2 {
        font-size: 1.5rem;
        margin-bottom: 2rem;
        font-weight: bold;
        font-style: italic;
    }
    .sidebar ul {
        list-style: none;
        padding: 0;
    }

    .sidebar li {
        margin: 1rem 0;
        font-size: 1.1rem;
        cursor: pointer;
        padding: 10px;
        border-radius: 5px;
        transition: background 0.3s;
    }

    .sidebar li:hover {
        background-color: rgba(255, 255, 255, 0.1);
    }

    /* Navbar droite */
    .navbar-right {
        width: 200px;
        height: 100%;
        position: fixed;
        right: 0;
        top: 0;
        padding-top: 20px;
        display: flex;
        flex-direction: column;
        background: rgb(0, 0, 0);
        border-left: 1px solid #444;
    }
    .navbar-right h4 {
        text-align: center;
        font-size: 1.2rem;
        margin-bottom: 10px;
    }

    .navbar-right .user {
        padding: 10px;
        text-align: center;
        font-size: 18px;
        border-bottom: 1px solid #444;
        transition: background 0.3s;
    }

    .navbar-right .user:hover {
        background-color: rgba(255, 255, 255, 0.1);
        cursor: pointer;
    }

    /* Contenu principal */
    .main-content {
        flex: 1;
        display: flex;
        justify-content: center;
        padding: 20px;
    }

    /* Conteneur des posts */
    .posts-container {
        width: 600px;
        margin-right: 20px;
    }

   .post {
        background: #fafafa;
        border: 1px solid #ddd;
        border-radius: 8px;
        text-align: center;
        padding: 15px;
        margin-bottom: 20px;
    }

    .post img {
        width: 100%;
        max-width: 100%;
        border-radius: 10px;
        max-height: 600px;
        object-fit: cover;
    }

    .post p {
        color: #000;
        margin: 1rem 0;
    }

    .post a {
        text-decoration: none;
        color: #e1306c;
        font-weight: bold;
        transition: color 0.3s;
    }

    .post a:hover {
        color: #c1275b;
    }
</style>

</head>
<body>

<div class="page-layout">

  <!-- Sidebar gauche -->
  <nav class="sidebar">
    <h2>Locia</h2>
    <ul>
      <li>🏠 Accueil</li>
      <li>&#128269; Recherche</li>
      <li>👤 Découvrir</li>
      <li>👤 Reels</li>
      <li>👤 Messages</li
      <li>❤️ Notifications</li>
      <li>📷 Créer</li>
      <li>👤 Profil</li>
      
    </ul>
  </nav>

  <!-- Contenu principal -->
  <main class="main-content">
    
    <!-- Posts -->
    <div class="posts-container">
      {% if posts is not empty %}
        {% for post in posts %}
          <div class="post">
            <img src="{{post.image}}" alt="Image">
            <p>{{ post.description }}</p>
            <a href="{{ path('post_like', {id: post.id}) }}">❤️ Like</a>
          </div>
        {% endfor %}
      {% else %}
         
      {% endif %}
    </div>

  </main>

</div>
   <!-- right navbar -->
  <div class="navbar-right">
    <h4>Suggestion followers</h4>
            <div class="user">👤Trinity</div>
            <div class="user">👤Urielle</div>
            <div class="user">👤Angelis</div>
            <div class="user">👤Emile Mvondo</div>
            <div class="user">👤Michelle</div>
        </div>

</body>
</html>
