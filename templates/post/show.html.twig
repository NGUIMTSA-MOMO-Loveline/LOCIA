{# templates/post/show.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ post.title }}{% endblock %}

{% block body %}
    <h1>{{ post.title }}</h1>
    <p>{{ post.content }}</p>
    <p>Publié le : {{ post.createdAt|date('d/m/Y H:i') }}</p>
    <a href="{{ path('app_post_edit', {'id': post.id}) }}">Modifier</a>
{% endblock %}