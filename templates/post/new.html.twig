{# templates/post/new.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Créer un Post{% endblock %}

{% block body %}
    <h1>Créer un nouveau post</h1>

    {{ form_start(form) }}
        {{ form_row(form.title) }}
        {{ form_row(form.content) }}
        <button type="submit">Publier</button>
    {{ form_end(form) }}
{% endblock %}