{# templates/like/show.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ post.title }}{% endblock %}

{% block body %}
    <h1>{{ post.title }}</h1>
    <p>{{ post.content }}</p>

    <p>Nombre de likes : {{ post.likes }}</p>

    <form action="{{ path('app_post_like', {'id': post.id}) }}" method="POST">
        <button type="submit">J'aime</button>
    </form>

    <p>Le post a été liké {{ post.likes }} fois.</p>
{% endblock %}